{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "wopi"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "kubectl.kubernetes.io/restartedAt": "2026-10-14T22:46:44+08:00",
          "office-lab/config-sha256": "e9329cb9220b50b8aa03811d6114c57664bdcc505014435d66e766f17bce7e6a",
          "office.cocolian.cn/source-sha256": "c8bfb3738891a2b9f5ad38ceda9d66568708b1f2bcc8f9b26d6ca5a5f1e1fdd9"
        },
        "labels": {
          "app": "wopi"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "python",
              "/app/server.py"
            ],
            "env": [
              {
                "name": "LAB_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "key",
                    "name": "lab-auth"
                  }
                }
              }
            ],
            "image": "docker.io/cocolian/office-portal@sha256:877522cb9df4cfe3d6903f7584a1c37164f3e4ff8dcd0c40e7c662fc9319222e",
            "imagePullPolicy": "Never",
            "name": "wopi",
            "ports": [
              {
                "containerPort": 8000,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/health",
                "port": 8000,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "resources": {
              "limits": {
                "cpu": "500m",
                "ephemeral-storage": "3Gi",
                "memory": "256Mi"
              },
              "requests": {
                "cpu": "100m",
                "ephemeral-storage": "128Mi",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsGroup": 1000,
              "runAsUser": 1000
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/data",
                "name": "data"
              }
            ]
          },
          {
            "command": [
              "nginx",
              "-c",
              "/config/nginx.conf",
              "-g",
              "daemon off;"
            ],
            "image": "docker.io/library/nginx@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10",
            "imagePullPolicy": "Never",
            "name": "gateway",
            "ports": [
              {
                "containerPort": 8080,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/health",
                "port": 8080,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "resources": {
              "limits": {
                "cpu": "250m",
                "ephemeral-storage": "3Gi",
                "memory": "128Mi"
              },
              "requests": {
                "cpu": "100m",
                "ephemeral-storage": "128Mi",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsGroup": 1000,
              "runAsUser": 1000
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/config",
                "name": "source",
                "readOnly": true
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 1000
        },
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "configMap": {
              "defaultMode": 420,
              "name": "lab-source"
            },
            "name": "source"
          },
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "wopi-data"
            }
          }
        ]
      }
    }
  },
  "metadata": {
    "name": "wopi",
    "namespace": "office-lab"
  }
}